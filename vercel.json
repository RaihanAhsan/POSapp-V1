{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "functions": {
    "backend/cmd/api/*.go": {
      "runtime": "go@1.22"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/backend/cmd/api"
    }
  ]
}
