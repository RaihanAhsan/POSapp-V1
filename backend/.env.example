# Go Backend Environment Variables

# Server Port:
# - On Vercel: Read automatically from runtime (defaults to 3000 if unset)
# - Local Standalone / Compose: Set to 8080
PORT=8080

# Database URL:
# - Local PostgreSQL: postgres://kasirku:kasirku_password@localhost:5432/kasirku_db?sslmode=disable
# - Vercel / Neon Pooler: postgres://user:pass@ep-xyz-pooler.us-east-2.aws.neon.tech/kasirku_db?sslmode=require
DATABASE_URL=postgres://kasirku:kasirku_password@localhost:5432/kasirku_db?sslmode=disable

# Database Pool Settings (Conservative defaults for Serverless / Neon PgBouncer):
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=5

# JWT Authentication:
JWT_SECRET=kasirku-super-secret-jwt-key-minimum-32-chars-long!
JWT_EXPIRATION_HOURS=8

# CORS (Defense-in-depth for local dev; Vercel same-origin rewrites bypass CORS):
CORS_ALLOWED_ORIGINS=http://localhost:3000
